        "lint": "oxlint",
        "check": "oxlint && oxfmt --check",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@magritte/api": "^0.2.1",
        "@magritte/fonts": "^0.2.1",
        "@magritte/rpc": "^0.2.1",
        "@magritte/sdk": "^0.2.1",
        "@phosphor-icons/react": "^2.1.10",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.101.4",
        "classnames": "^2.5.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwindcss": "^4.3.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "jsdom": "^31.0.0",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2004",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
