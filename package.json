{
    "name": "@magritte/extension-linernotes",
    "private": true,
    "license": "GPL-3.0-only",
    "type": "module",
    "scripts": {
        "dev": "vite --port 9295",
        "start": "vite --port 9296",
        "build": "vite build && tsc",
        "clean": "rm -rf dist",
